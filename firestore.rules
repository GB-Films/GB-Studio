rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function admin() {
      return googleUser() && request.auth.token.email.lower() == 'info@granbertafilms.com';
    }
    function staffData() {
      return get(/databases/$(database)/documents/reviewStaff/$(request.auth.token.email.lower())).data;
    }
    function clientRole() {
      let staff = staffData();
      return ('roles' in staff && 'reviews' in staff.roles && staff.roles.reviews == 'client')
        || ('permissions' in staff && 'reviewsClient' in staff.permissions && staff.permissions.reviewsClient == true);
    }
    function permission(name) {
      return admin() || (googleUser()
        && exists(/databases/$(database)/documents/reviewStaff/$(request.auth.token.email.lower()))
        && (!('active' in get(/databases/$(database)/documents/reviewStaff/$(request.auth.token.email.lower())).data)
          || get(/databases/$(database)/documents/reviewStaff/$(request.auth.token.email.lower())).data.active == true)
        // Client is exclusive even when an older record also contains broad Mira flags.
        && (name in ['storyboards', 'storyboardsView', 'pdr', 'pdrView', 'reviewsClient'] || !clientRole())
        // Legacy records without explicit permissions keep Visto, never all of Mira.
        && ((name in ['storyboards', 'storyboardsView'] && !('permissions' in staffData()))
          || (name == 'reviewsClient' && clientRole())
          || ('permissions' in staffData()
            && name in staffData().permissions
            && staffData().permissions[name] == true)));
    }
    function activeShare(token) {
      return exists(/databases/$(database)/documents/reviewShares/$(token))
        && get(/databases/$(database)/documents/reviewShares/$(token)).data.active == true;
    }
    function parentFile(token, fileId) {
      return exists(/databases/$(database)/documents/reviewShares/$(token)/files/$(fileId));
    }

    match /reviewStaff/{email} {
      allow get: if admin() || (googleUser() && request.auth.token.email.lower() == email);
      allow list, create, update, delete: if admin();
    }

    // Both Visto roles can see the shared library; only full access can change it.
    match /storyboardProjects/{projectId} {
      allow read: if permission('storyboards') || permission('storyboardsView') || permission('pdr') || permission('pdrView');
      allow create, update, delete: if permission('storyboards') || permission('pdr');
      match /chunks/{chunkId} {
        allow read: if permission('storyboards') || permission('storyboardsView') || permission('pdr') || permission('pdrView');
        allow create, update, delete: if permission('storyboards') || permission('pdr');
      }
    }

    match /accessRequests/{uid} {
      allow get: if admin() || (googleUser() && request.auth.uid == uid);
      allow list, delete: if admin();
      allow create: if googleUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'email', 'name', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if false;
    }

    // Private working library for the Google-authorized team. Guests never read these.
    match /reviewProjects/{projectId} {
      allow read: if permission('reviewsView');
      allow create: if permission('reviewsCreate');
      allow update, delete: if permission('reviewsEdit');
    }
    match /reviewItems/{fileId} {
      allow read: if permission('reviewsView');
      allow create, update, delete: if permission('reviewsEdit');
    }

    // Friendly links are intentionally public by name, but never listable.
    // Bindings are permanent: an old client link must never open another project.
    match /reviewLinks/{alias} {
      allow get: if permission('reviewsShare') || (activeShare(resource.data.token)
        && parentFile(resource.data.token, resource.data.fileId));
      allow list: if false;
      allow create: if permission('reviewsShare')
        && alias.matches('^[a-z0-9]([a-z0-9-]{0,158}[a-z0-9])?$')
        && request.resource.data.keys().hasOnly(['token', 'fileId', 'projectId', 'versionId', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['token', 'fileId', 'projectId', 'versionId', 'createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is string
        && request.resource.data.token is string
        && request.resource.data.fileId is string
        && request.resource.data.projectId is string
        && request.resource.data.versionId is string
        && activeShare(request.resource.data.token)
        && parentFile(request.resource.data.token, request.resource.data.fileId)
        && request.resource.data.projectId == get(/databases/$(database)/documents/reviewShares/$(request.resource.data.token)).data.projectId
        && request.resource.data.versionId == get(/databases/$(database)/documents/reviewShares/$(request.resource.data.token)).data.versionId;
      allow update, delete: if false;
    }

    match /reviewShares/{token} {
      // An unguessable URL token is the guest's capability. No collection listing.
      allow get: if permission('reviewsView') || resource.data.active == true;
      allow list: if permission('reviewsView');
      allow create, delete: if permission('reviewsShare');
      allow update: if permission('reviewsShare') || (permission('reviewsEdit')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'projectTitle', 'versionTitle', 'category', 'sections', 'client', 'agency', 'director', 'updatedAt'
        ]));

      match /files/{fileId} {
        allow get, list: if permission('reviewsView') || activeShare(token);
        allow create, update: if permission('reviewsEdit')
          && request.resource.data.source == 'dropbox'
          && request.resource.data.sourceUrl is string
          && request.resource.data.sourceUrl.matches('^https://(www[.])?dropbox[.]com/(s|scl)/.*')
          && request.resource.data.kind in ['video', 'image', 'model'];
        allow delete: if permission('reviewsEdit');

        match /comments/{commentId} {
          allow get, list: if permission('reviewsView') || (activeShare(token) && parentFile(token, fileId));
          allow create: if request.auth != null && (permission('reviewsEdit') || activeShare(token)) && parentFile(token, fileId)
            && request.resource.data.keys().hasOnly(['id', 'text', 'time', 'strokesJson', 'resolved', 'createdAt', 'authorUid', 'authorName'])
            && request.resource.data.id == commentId
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 60
            && request.resource.data.text is string && request.resource.data.text.size() <= 5000
            && request.resource.data.time is number && request.resource.data.time >= 0
            && request.resource.data.strokesJson is string && request.resource.data.strokesJson.size() <= 200000
            && request.resource.data.resolved is bool
            && (permission('reviewsEdit') || request.resource.data.resolved == false);
          // Authors can edit only their own text; the team can resolve any comment.
          allow update: if request.auth != null
            && ((resource.data.authorUid == request.auth.uid
              && (permission('reviewsEdit') || (activeShare(token) && parentFile(token, fileId)))
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
              && request.resource.data.text is string && request.resource.data.text.size() <= 5000)
              || (permission('reviewsEdit')
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
                && request.resource.data.resolved is bool));
          allow delete: if permission('reviewsEdit') || (request.auth != null
            && activeShare(token) && parentFile(token, fileId)
            && resource.data.authorUid == request.auth.uid);
        }
      }
    }
  }
}
